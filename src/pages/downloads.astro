---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    title: '종합 카탈로그',
    files: [
      { title: 'CREATON 기와 종합카탈로그 (2024)', desc: '전체 기와 라인업 및 색상 안내', size: '14 MB', href: '/downloads/creaton-catalog-2024.pdf' },
    ],
  },
  {
    title: '제품별 카탈로그',
    files: [
      { title: 'FUTURA 카탈로그', desc: '낮은 골기와', size: '11.8 MB', href: '/downloads/catalog-futura.pdf' },
      { title: 'HARMONIE 카탈로그', desc: '낮은 골기와', size: '4.2 MB', href: '/downloads/catalog-harmonie.pdf' },
      { title: 'MIKADO 카탈로그', desc: '평기와', size: '2.0 MB', href: '/downloads/catalog-mikado.pdf' },
      { title: 'DOMINO 카탈로그', desc: '평기와', size: '2.1 MB', href: '/downloads/catalog-domino.pdf' },
      { title: 'VISIO 카탈로그', desc: '평기와', size: '3.3 MB', href: '/downloads/catalog-visio.pdf' },
      { title: 'KLASSIK · BIBER 카탈로그', desc: '평판 기와', size: '23.5 MB', href: '/downloads/catalog-klassik-biber.pdf' },
      { title: 'MAGNUM 카탈로그', desc: '콘크리트 기와', size: '2.1 MB', href: '/downloads/catalog-magnum.pdf' },
    ],
  },
  {
    title: '기술자료 (TDS) · 시공 매뉴얼',
    files: [
      { title: 'DUO extra 투습방수지 기술자료', desc: '지붕 하부 투습방수지', size: '0.9 MB', href: '/downloads/tds-duo-extra.pdf' },
      { title: 'TRIO extra 투습방수지 기술자료', desc: '지붕 하부 투습방수지', size: '1.0 MB', href: '/downloads/tds-trio-extra.pdf' },
      { title: '시스템 솔라 브라켓 셋트 설치매뉴얼', desc: '태양광 마운팅 브라켓 시공 안내', size: '6.5 MB', href: '/downloads/manual-solar-bracket.pdf' },
    ],
  },
];
---

<BaseLayout
  title="기술자료 | CREATON Korea"
  description="CREATON 제품 카탈로그, 시공 가이드, 규격서 등 기술자료 다운로드."
>
  <section class="page-hero bg-ink">
    <div class="container">
      <span class="eyebrow" style="color:#ff9aa8">DOWNLOADS</span>
      <h1>기술자료</h1>
      <p class="lead" style="color:rgba(255,255,255,.82)">
        제품 카탈로그와 시공 가이드, 규격서를 다운로드하실 수 있습니다.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      {sections.map((sec) => (
        <div class="file-section">
          <h2 class="file-section-title">{sec.title}</h2>
          <ul class="file-list">
            {sec.files.map((f) => (
              <li>
                <a href={f.href} class="file-row" download>
                  <div class="file-icon">PDF</div>
                  <div class="file-info">
                    <strong>{f.title}</strong>
                    <span>{f.desc}</span>
                  </div>
                  <span class="file-size">{f.size}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="note">※ 원하시는 자료가 없으신가요? <a href="/contact">문의하기</a>를 통해 요청해 주세요.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { padding-block: clamp(56px, 9vw, 96px); }
  .page-hero h1 { color: #fff; font-size: clamp(1.8rem, 5vw, 2.8rem); }
  .narrow { max-width: 760px; }
  .file-section { margin-bottom: 40px; }
  .file-section-title { font-size: 1.1rem; margin-bottom: 16px; }
  .file-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .file-row {
    display: flex; align-items: center; gap: 18px;
    padding: 18px 20px;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background: #fff;
    transition: border-color .15s, box-shadow .15s;
  }
  .file-row:hover { border-color: var(--c-red); box-shadow: var(--shadow-sm); }
  .file-icon {
    flex: none;
    width: 46px; height: 46px;
    display: grid; place-items: center;
    background: #fdecef; color: var(--c-red);
    font-weight: 700; font-size: 0.75rem;
    border-radius: var(--radius);
  }
  .file-info { flex: 1; }
  .file-info strong { display: block; font-size: 1rem; }
  .file-info span { font-size: 0.88rem; color: var(--c-muted); }
  .file-size { font-size: 0.8rem; color: var(--c-muted); white-space: nowrap; }
  .note { margin-top: 24px; font-size: 0.9rem; color: var(--c-muted); }
  .note a { color: var(--c-red); font-weight: 600; }
</style>
