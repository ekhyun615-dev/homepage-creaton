---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="페이지를 찾을 수 없습니다 | CREATON Korea">
  <section class="section text-center">
    <div class="container narrow">
      <span class="eyebrow">404</span>
      <h1 class="section-title">페이지를 찾을 수 없습니다</h1>
      <p class="lead mx-auto">요청하신 페이지가 이동되었거나 존재하지 않습니다.</p>
      <div style="margin-top:28px; display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
        <a href="/" class="btn btn-primary">홈으로 돌아가기</a>
        <a href="/contact" class="btn btn-outline">문의하기</a>
      </div>
    </div>
  </section>
</BaseLayout>
