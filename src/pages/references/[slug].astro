---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const refs = await getCollection('references', ({ data }) => !data.draft);
  return refs.map((r) => ({ params: { slug: r.slug }, props: { entry: r } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;
const meta = [
  ['위치', d.location],
  ['건물 유형', d.buildingType],
  ['적용 제품', d.product],
  ['시공 시기', d.date],
].filter(([, v]) => v);
const hasGallery = d.gallery && d.gallery.length > 1;
---

<BaseLayout title={`${d.title} | 시공 사례 | CREATON Korea`} description={`${d.title} — ${[d.location, d.buildingType].filter(Boolean).join(', ')}`}>
  <article>
    <section class="ref-hero" style={d.image ? `background-image:url(${d.image})` : ''}>
      <div class="ref-hero-overlay"></div>
      <div class="container ref-hero-inner">
        <a href="/references" class="back">← 시공 사례</a>
        <h1>{d.title}</h1>
        <p>{[d.location, d.buildingType].filter(Boolean).join(' · ')}</p>
      </div>
    </section>

    <section class="section">
      <div class="container ref-body">
        <div class="prose">
          <Content />

          {hasGallery && (
            <div class="slider" data-slider>
              <div class="slides">
                {d.gallery!.map((src, i) => (
                  <div class="slide" data-index={i}>
                    <img src={src} alt={`${d.title} 시공 사진 ${i + 1}`} loading="lazy" />
                  </div>
                ))}
              </div>
              <button class="slider-btn prev" aria-label="이전 사진" data-prev>‹</button>
              <button class="slider-btn next" aria-label="다음 사진" data-next>›</button>
              <div class="slider-dots" data-dots>
                {d.gallery!.map((_, i) => (
                  <button class="dot" data-dot={i} aria-label={`${i + 1}번 사진`}></button>
                ))}
              </div>
            </div>
          )}
        </div>
        <aside class="ref-meta-box">
          <h4>프로젝트 정보</h4>
          <dl>
            {meta.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
          </dl>
          <a href="/contact" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:8px">비슷한 시공 문의</a>
        </aside>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .ref-hero {
    position: relative;
    min-height: 46vh;
    display: flex;
    align-items: flex-end;
    background: var(--c-anthracite) center/cover no-repeat;
    color: #fff;
  }
  .ref-hero-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, transparent, rgba(0,0,0,.6)); }
  .ref-hero-inner { position: relative; padding-block: 40px; }
  .ref-hero-inner h1 { color: #fff; font-size: clamp(1.6rem, 4.5vw, 2.6rem); }
  .ref-hero-inner p { color: rgba(255,255,255,.85); margin: 0; }
  .back { display: inline-block; color: rgba(255,255,255,.85); font-size: 0.9rem; margin-bottom: 12px; }
  .ref-body { display: grid; gap: 40px; grid-template-columns: 1fr; }
  .prose :global(p) { color: var(--c-slate); }
  .prose :global(h2) { margin-top: 1.4em; }
  .ref-meta-box {
    align-self: start;
    padding: 24px;
    background: var(--c-bg-soft);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
  }
  .ref-meta-box h4 { margin: 0 0 14px; font-size: 0.95rem; }
  .ref-meta-box dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 8px 16px; }
  .ref-meta-box dt { color: var(--c-muted); font-size: 0.85rem; }
  .ref-meta-box dd { margin: 0; font-size: 0.9rem; font-weight: 500; }
  @media (min-width: 860px) { .ref-body { grid-template-columns: 1fr 300px; } }

  /* 시공 사진 슬라이더 */
  .slider { position: relative; margin-top: 32px; border-radius: var(--radius); overflow: hidden; background: var(--c-bg-clay); }
  .slides { display: flex; transition: transform 0.35s ease; }
  .slide { min-width: 100%; aspect-ratio: 16 / 10; }
  .slide img { width: 100%; height: 100%; object-fit: cover; }
  .slider-btn {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 44px; height: 44px; border-radius: 50%;
    background: rgba(255,255,255,0.9); border: none; cursor: pointer;
    font-size: 1.6rem; line-height: 1; color: var(--c-ink);
    display: flex; align-items: center; justify-content: center;
  }
  .slider-btn.prev { left: 12px; }
  .slider-btn.next { right: 12px; }
  .slider-dots { position: absolute; bottom: 12px; left: 0; right: 0; display: flex; gap: 8px; justify-content: center; }
  .dot { width: 9px; height: 9px; border-radius: 50%; border: none; background: rgba(255,255,255,0.6); cursor: pointer; padding: 0; }
  .dot.active { background: #fff; }
</style>

<script>
  document.querySelectorAll('[data-slider]').forEach((slider) => {
    const slides = slider.querySelector('.slides') as HTMLElement | null;
    const total = slider.querySelectorAll('.slide').length;
    const dots = slider.querySelectorAll('[data-dot]');
    let idx = 0;
    const go = (n: number) => {
      idx = (n + total) % total;
      if (slides) slides.style.transform = `translateX(-${idx * 100}%)`;
      dots.forEach((d, i) => d.classList.toggle('active', i === idx));
    };
    slider.querySelector('[data-prev]')?.addEventListener('click', () => go(idx - 1));
    slider.querySelector('[data-next]')?.addEventListener('click', () => go(idx + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    go(0);
  });
</script>
