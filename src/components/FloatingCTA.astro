---
const tel = '1833-2190';
const telHref = `tel:${tel}`;
---

<div class="fab">
  <a href={telHref} class="fab__btn fab__btn--tel" aria-label={`전화 문의 ${tel}`}>
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.2 1l-2.3 2.2z"/></svg>
    <span class="fab__label">전화 문의</span>
  </a>
  <a href="/contact" class="fab__btn fab__btn--quote" aria-label="상담 신청">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    <span class="fab__label">상담 신청</span>
  </a>
</div>

<style>
  .fab {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 90;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .fab__btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px;
    border-radius: 999px;
    color: #fff;
    font-weight: 700;
    box-shadow: var(--shadow-md);
    transition: transform 0.2s ease, padding 0.2s ease;
  }
  .fab__btn--tel { background: var(--c-ink); }
  .fab__btn--quote { background: var(--c-red); }
  .fab__btn:hover { transform: translateY(-2px); }
  .fab__label {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    font-size: 0.95rem;
    transition: max-width 0.25s ease;
  }
  .fab__btn:hover .fab__label { max-width: 120px; }

  @media (max-width: 1024px) {
    .fab { right: 14px; bottom: 14px; flex-direction: row; }
    .fab__label { display: none; }
    .fab__btn { padding: 15px; }
  }
</style>
